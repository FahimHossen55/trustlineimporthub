# Secret key used for JWT signing (generate a strong key with secrets.token_urlsafe(64))
SECRET_KEY=change-this-to-a-strong-random-secret-key-at-least-32-chars
TOKEN_EXPIRE_MINUTES=120

# Set to true when the site is served over HTTPS (production on Render)
COOKIE_SECURE=true

# Database connection
# Local SQLite:
# DATABASE_URL=sqlite:///./trustline.db
# Neon PostgreSQL (Production):
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./trustline.db

# Cloudinary image storage (Production)
# Get from Cloudinary Dashboard: API Environment variable
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_FOLDER=trustline

# Optional Admin Credentials for initial setup
# ADMIN_USERNAME=shahin
# ADMIN_PASSWORD=YourStrongPasswordHere!
